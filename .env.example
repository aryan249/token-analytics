# ── RPC ──────────────────────────────────────────────────────────────────────
ALCHEMY_WS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://postgres:password@localhost:5432/flaunch
# Optional read replica for API queries (falls back to POSTGRES_URL)
# POSTGRES_READ_URL=postgresql://postgres:password@localhost:5432/flaunch

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Chain ────────────────────────────────────────────────────────────────────
CHAIN_ID=8453
CONFIRMATION_DEPTH=3
BATCH_SIZE=100

# Override to start indexing from a specific block (otherwise resumes from checkpoint)
# START_BLOCK=43733135

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000

# ── Auth (wallet-based JWT) ──────────────────────────────────────────────────
# Set JWT_SECRET to enable authentication. When set:
#   - POST /auth/login (wallet signature) returns a JWT
#   - All other endpoints require Authorization: Bearer <token>
#   - WebSocket requires ?token=<jwt> query param
# Leave empty to disable auth (local dev)
# JWT_SECRET=your-random-secret-at-least-32-chars
# JWT_EXPIRY=24h

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
